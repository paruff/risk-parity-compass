{
  "name": "risk-parity-compass",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "Risk parity rebalancing and retirement drawdown planner. Runs in the browser.",
  "license": "MIT",
  "author": "Phil Ruff",
  "homepage": "https://paruff.github.io/risk-parity-compass/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paruff/risk-parity-compass.git"
  },
  "bugs": {
    "url": "https://github.com/paruff/risk-parity-compass/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.1.3",
    "lefthook": "^2.2.2",
    "lint-staged": "^15.2.0",
    "msw": "^2.15.0",
    "prettier": "^3.3.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
